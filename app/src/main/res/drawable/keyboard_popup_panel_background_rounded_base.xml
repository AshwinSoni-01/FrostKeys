<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item>
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="#06777777" />
            <padding android:top="0dp" android:right="2dp" android:bottom="2dp" android:left="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="#10777777" />
            <padding android:top="0dp" android:right="1dp" android:bottom="2dp" android:left="1dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="#18777777" />
            <padding android:top="0dp" android:right="1dp" android:bottom="1dp" android:left="1dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="#22777777" />
            <padding android:top="0dp" android:right="0dp" android:bottom="1dp" android:left="0dp" />
        </shape>
    </item>
    <!-- Popup background -->
    <item>
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="#ffffff" />
        </shape>
    </item>
</layer-list>
